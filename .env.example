# EmailJS Configuration
# Get these values from your EmailJS account: https://dashboard.emailjs.com/
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here

# reCAPTCHA Configuration
# Get your site key from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Google Tag Manager Configuration
GTM_ID=your_gtm_id_here

# Site URL (used for sitemap and canonical/hreflang tags)
SITE_URL=https://vocdoni.io

# Product URLs surfaced in the UI. Override to point CTAs/links at other
# environments (staging, previews). Defaults are the production values.
APP_URL=https://app.vocdoni.io
PLATFORM_URL=https://platform.vocdoni.io

# Keystatic CMS (production only, GitHub storage). Generated by the guided setup
# at /keystatic on the first deploy, then stored as Netlify env vars. Not needed
# for local editing (dev uses local file storage).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
