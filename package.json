{
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike preview",
    "shadcn": "npx shadcn@latest",
    "lint": "tsc && prettier --check ./components ./lib ./layouts ./pages ./plugins ./tests",
    "prepare": "husky",
    "test": "vitest run tests",
    "translations": "i18next-cli extract",
    "gen:do-ingress": "tsx scripts/gen-do-ingress.ts",
    "gen:do-appspec": "tsx scripts/gen-do-appspec.ts",
    "guardrails": "pnpm run guardrails:components && pnpm run guardrails:i18n-dynamic-keys && pnpm run guardrails:translations && pnpm run guardrails:translations:non-empty && pnpm run guardrails:translations:no-copy && pnpm run guardrails:i18n-copy",
    "guardrails:components": "node scripts/guardrails/check-component-structure.mjs",
    "guardrails:i18n-copy": "node scripts/guardrails/check-hardcoded-copy.mjs",
    "guardrails:i18n-dynamic-keys": "node scripts/guardrails/check-dynamic-translation-keys.mjs",
    "guardrails:translations": "pnpm exec i18next-cli extract --ci",
    "guardrails:translations:non-empty": "node scripts/guardrails/check-non-empty-translations.mjs",
    "guardrails:translations:no-copy": "node scripts/guardrails/check-untranslated-copy.mjs",
    "validate": "pnpm run lint && pnpm run test && pnpm run guardrails",
    "prerender": "vike prerender"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
